diff --git a/include/freetype/internal/cfftypes.h b/include/freetype/internal/cfftypes.h
index 754122fa6..16b2e2fad 100644
--- a/include/freetype/internal/cfftypes.h
+++ b/include/freetype/internal/cfftypes.h
@@ -328,6 +328,11 @@ FT_BEGIN_HEADER
 
     FT_UInt32  random;
 
+    /* `local_subrs` and `local_subrs_index` alias an earlier subfont
+     * that named the same INDEX. That subfont frees them.
+     */
+    FT_Bool  local_subrs_shared;
+
   } CFF_SubFontRec;
 
 
diff --git a/src/cff/cffload.c b/src/cff/cffload.c
index 39d662eb4..a8eb89cb3 100644
--- a/src/cff/cffload.c
+++ b/src/cff/cffload.c
@@ -2134,8 +2134,33 @@
     /* read the local subrs, if any */
     if ( priv->local_subrs_offset )
     {
-      if ( FT_STREAM_SEEK( base_offset + top->private_offset +
-                           priv->local_subrs_offset ) )
+      FT_ULong  subr_pos = base_offset + top->private_offset +
+                           priv->local_subrs_offset;
+      FT_UInt   prev;
+
+
+      /* Font DICTs often share one Private DICT, so this INDEX is the
+       * same bytes again. A second offset table and pointer table is
+       * the amplification: 256 DICTs and one 20,000-entry INDEX ask for
+       * about 80MB. Reuse the first subfont's tables. It frees them.
+       */
+      for ( prev = 0; prev < font->num_subfonts; prev++ )
+      {
+        CFF_SubFont  other = font->subfonts[prev];
+
+
+        if ( other == subfont                   ||
+             !other->local_subrs                ||
+             other->local_subrs_index.start != subr_pos )
+          continue;
+
+        subfont->local_subrs_index  = other->local_subrs_index;
+        subfont->local_subrs        = other->local_subrs;
+        subfont->local_subrs_shared = 1;
+        goto Exit;
+      }
+
+      if ( FT_STREAM_SEEK( subr_pos ) )
         goto Exit;
 
       error = cff_index_init( &subfont->local_subrs_index, stream, 1, cff2 );
@@ -2161,8 +2186,11 @@
   {
     if ( subfont )
     {
-      cff_index_done( &subfont->local_subrs_index );
-      FT_FREE( subfont->local_subrs );
+      if ( !subfont->local_subrs_shared )
+      {
+        cff_index_done( &subfont->local_subrs_index );
+        FT_FREE( subfont->local_subrs );
+      }
 
       FT_FREE( subfont->blend.lastNDV );
       FT_FREE( subfont->blend.BV );
